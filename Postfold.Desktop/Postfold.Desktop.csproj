<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>Postfold</AssemblyName>
        <RootNamespace>Postfold.Desktop</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>../Postfold.UI/Resources/Postfold.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Velopack" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" />
        <ProjectReference Include="../Postfold.Core/Postfold.Core.csproj" />
        <ProjectReference Include="../Postfold.Protocols/Postfold.Protocols.csproj" />
        <ProjectReference Include="../Postfold.Storage/Postfold.Storage.csproj" />
        <ProjectReference Include="../Postfold.Sync/Postfold.Sync.csproj" />
        <ProjectReference Include="../Postfold.UI/Postfold.UI.csproj" />
        <ProjectReference Include="../Postfold.UpdateBroker/Postfold.UpdateBroker.csproj" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="Avalonia.Controls.WebView" />
        <PackageReference Include="Microsoft.Web.WebView2" ExcludeAssets="compile;build;buildTransitive"
                          PrivateAssets="all" GeneratePathProperty="true" />
        <Reference Include="Microsoft.Web.WebView2.Core">
            <HintPath>$(PkgMicrosoft_Web_WebView2)/lib_manual/netcoreapp3.0/Microsoft.Web.WebView2.Core.dll</HintPath>
        </Reference>
        <PackageReference Include="Avalonia.Themes.Fluent" />
    </ItemGroup>
</Project>
