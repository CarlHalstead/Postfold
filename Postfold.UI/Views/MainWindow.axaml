<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Postfold.UI.Resources"
    xmlns:viewModels="using:Postfold.UI.ViewModels"
    xmlns:controls="using:Postfold.UI.Controls"
    xmlns:models="using:Postfold.UI.Models"
    xmlns:core="using:Postfold.Core.Models.Messages"
    xmlns:converters="using:Postfold.UI.Converters"
    x:Class="Postfold.UI.Views.MainWindow"
    x:DataType="viewModels:MainWindowViewModel"
    Title="{Binding Title}"
    Width="1400"
    Height="900"
    MinWidth="760"
    MinHeight="480">
    <Window.Resources>
        <converters:AttachmentSizeConverter x:Key="AttachmentSize" />
        <converters:AttachmentTypeConverter x:Key="AttachmentType" />
        <converters:StateTextConverter x:Key="ContentState" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Path.sync-spinner.animated">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>
    <Grid>
        <Grid Name="Panes" ColumnDefinitions="0.19*,5,0.36*,5,0.45*">
            <DockPanel Name="NavigationPane" Background="{DynamicResource MailNavigationBrush}">
                <StackPanel DockPanel.Dock="Top" Margin="16" Spacing="16">
                    <Button Name="ComposeButton" IsEnabled="{Binding HasAccounts}" Classes="primary" HorizontalAlignment="Stretch" MinHeight="48" AutomationProperties.Name="{x:Static ui:Strings.NewMail}">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Path Data="{StaticResource ComposeIcon}" Stroke="{DynamicResource MailAccentTextBrush}" Width="20" Height="20" />
                            <TextBlock Text="{x:Static ui:Strings.NewMail}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8" Spacing="4">
                    <Border Background="{DynamicResource MailLineBrush}" Height="1" Margin="0,0,0,8" />
                    <Button Classes="navigation" Name="WorkButton" Content="{x:Static ui:Strings.Work}" IsEnabled="{Binding HasAccounts}" />
                    <Button Classes="navigation" Name="SetupButton" AutomationProperties.Name="{x:Static ui:Strings.Setup}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Path Data="{StaticResource AddIcon}" Width="20" Height="20" />
                            <TextBlock Text="{x:Static ui:Strings.Setup}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Background="{DynamicResource MailLineBrush}" Height="1" Margin="0,8" />
                    <Button Classes="navigation" Name="SettingsButton" AutomationProperties.Name="{x:Static ui:Strings.Settings}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Path Data="{StaticResource SettingsIcon}" Width="20" Height="20" />
                            <TextBlock Text="{x:Static ui:Strings.Settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TreeView
                    Name="ScopeList"
                    Focusable="True"
                    ItemsSource="{Binding Navigation}"
                    SelectedItem="{Binding NavigationSelection}"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="12,0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.AllowAutoHide="False"
                    AutomationProperties.Name="{x:Static ui:Strings.Scope}">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="viewModels:NavigationItemViewModel">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <StackPanel>
                                        <Border Height="1" Background="{DynamicResource MailLineBrush}" IsVisible="{Binding IsAccount}" Margin="8,12,8,8" />
                                        <Border Name="PART_LayoutRoot" CornerRadius="8" Background="{TemplateBinding Background}" Focusable="True" TemplatedControl.IsTemplateFocusTarget="True">
                                            <Grid Name="PART_Header" ColumnDefinitions="*,Auto" Margin="0,0,12,0" Background="Transparent" PointerPressed="AccountHeaderPointerPressed" DragDrop.AllowDrop="True" DragDrop.DragOver="FolderDragOver" DragDrop.Drop="FolderDrop">
                                                <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                                                <ToggleButton Name="PART_ExpandCollapseChevron" Grid.Column="1" Theme="{StaticResource FluentTreeViewExpandCollapseChevron}" VerticalAlignment="Center" Focusable="False" AutomationProperties.AccessibilityView="Raw" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                                            </Grid>
                                        </Border>
                                        <controls:AnimatedDisclosure IsExpanded="{TemplateBinding IsExpanded}">
                                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </controls:AnimatedDisclosure>
                                    </StackPanel>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
                            <Setter Property="IsVisible" Value="False" />
                        </Style>
                        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
                            <Setter Property="Background" Value="{DynamicResource MailHoverBrush}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="viewModels:NavigationItemViewModel" ItemsSource="{Binding Children}">
                            <StackPanel>
                                <Grid ColumnDefinitions="24,*,Auto" Margin="{Binding RowMargin}">
                                    <Grid.ContextMenu>
                                        <ContextMenu IsEnabled="{Binding IsAccount}">
                                            <MenuItem Header="{x:Static ui:Strings.RenameAccount}" Click="RenameAccountClicked" />
                                            <MenuItem Header="{x:Static ui:Strings.Settings}" Click="AccountSettingsClicked" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Path Data="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding AccessibleName}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="caption" VerticalAlignment="Center" ToolTip.Tip="{Binding AccessibleName}" />
                                </Grid>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
            <GridSplitter Name="NavigationSplitter" Grid.Column="1" ResizeDirection="Columns" AutomationProperties.Name="{x:Static ui:Strings.NavigationResize}" />
            <DockPanel Grid.Column="2" Name="MessagePane">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Name="ListToolbar" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" MinHeight="64" Margin="16,0">
                        <Border Background="{DynamicResource MailNavigationBrush}" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Name="SearchButton" Classes="quiet" Command="{Binding RefreshCommand}" AutomationProperties.Name="{x:Static ui:Strings.Search}" Padding="10">
                                    <Path Data="{StaticResource SearchIcon}" Width="18" Height="18" />
                                </Button>
                                <TextBox Grid.Column="1" Name="SearchBox" Classes="search" Text="{Binding Terms}" PlaceholderText="{x:Static ui:Strings.Search}" AutomationProperties.Name="{x:Static ui:Strings.Search}" MaxLength="1024" Background="Transparent" MinWidth="80" />
                            </Grid>
                        </Border>
                        <StackPanel Name="ListFilters" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Name="AllFilterButton" Classes="filter" Content="{x:Static ui:Strings.AllMail}" IsChecked="{Binding AllMail, Mode=OneWay}" GroupName="MailFilter" />
                            <RadioButton Name="UnreadFilter" Classes="filter" Content="{x:Static ui:Strings.Unread}" IsChecked="{Binding UnreadOnly, Mode=OneWay}" GroupName="MailFilter" />
                        </StackPanel>
                        <Button Name="ListMoreButton" Grid.Column="2" Classes="quiet" Padding="10" MinWidth="40" MinHeight="40" VerticalAlignment="Center" AutomationProperties.Name="{x:Static ui:Strings.FiltersAndMore}" ToolTip.Tip="{x:Static ui:Strings.FiltersAndMore}" Click="OpenMenuClicked">
                            <Path Data="{StaticResource MoreIcon}" Fill="{DynamicResource MailTextBrush}" StrokeThickness="0" Width="20" Height="5" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static ui:Strings.Synchronise}" Command="{Binding SynchroniseCommand}" />
                                    <MenuItem Header="{x:Static ui:Strings.More}" Command="{Binding MoreCommand}" IsVisible="{Binding HasMore}" />
                                    <MenuItem Header="{x:Static ui:Strings.SearchScopeHint}" Click="SearchHelpClicked" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding SearchScope}" Classes="caption" Margin="16,0,16,8" TextTrimming="CharacterEllipsis" ToolTip.Tip="{x:Static ui:Strings.SearchHint}" />
                    <TextBlock Text="{Binding SelectionDescription}" IsVisible="{Binding HasMessageSelection}" Margin="16,0,16,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button Name="LoadMoreButton" DockPanel.Dock="Bottom" Content="{x:Static ui:Strings.More}" Command="{Binding MoreCommand}" IsVisible="False" Margin="16,8" HorizontalAlignment="Stretch" />
                <Grid Name="MessageRegion" ClipToBounds="True">
                    <TextBlock Text="{x:Static ui:Strings.NoMessages}" IsVisible="{Binding IsEmpty}" Margin="24" TextWrapping="Wrap" />
                    <ListBox Name="MessageList" Focusable="True" Classes="mail summaries" ItemsSource="{Binding Rows}" SelectionMode="Multiple" SelectedItems="{Binding SelectedRows, Mode=OneWay}" AutomationProperties.Name="{x:Static ui:Strings.Messages}" Margin="12,0">
                        <ListBox.ContextMenu>
                            <ContextMenu Opening="MessageMenuOpening">
                                <MenuItem Name="MessageEditDraftMenu" Header="{x:Static ui:Strings.EditDraft}" IsVisible="False" />
                                <MenuItem Name="MessageReplyMenu" Header="{x:Static ui:Strings.Reply}" Click="MessageReplyClicked" IsEnabled="{Binding CanComposeFromMessage}" />
                                <MenuItem Name="MessageForwardMenu" Header="{x:Static ui:Strings.Forward}" Click="MessageForwardClicked" IsEnabled="{Binding CanComposeFromMessage}" />
                                <MenuItem Name="MessageTrashMenu" Header="{x:Static ui:Strings.Trash}" Click="MessageTrashClicked" />
                                <MenuItem Name="MessageReadMenu" Click="MessageReadClicked" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem" x:DataType="models:MessageSummary">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:MessageSummary">
                                <StackPanel>
                                    <TextBlock Text="{Binding Group}" IsVisible="{Binding HasGroup}" Classes="caption" Margin="4,8,0,4" />
                                    <Border Name="SummarySurface" Padding="{DynamicResource MessagePadding}" CornerRadius="8" MinHeight="{DynamicResource MessageMinimumHeight}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MailLineBrush}">
                                        <Grid ColumnDefinitions="8,Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource MailAccentBrush}" IsVisible="{Binding Unread}" VerticalAlignment="Center" />
                                            <Border Name="SenderAvatar" Grid.Column="1" Grid.RowSpan="3" Width="{DynamicResource AvatarSize}" Height="{DynamicResource AvatarSize}" CornerRadius="32" Background="{DynamicResource MailAvatarBrush}" VerticalAlignment="Center" Margin="4,0,12,0">
                                                <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Sender}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Date}" Classes="caption" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Subject}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" Margin="0,2,8,0" />
                                            <Path Grid.Column="3" Grid.Row="1" Data="{StaticResource AttachmentIcon}" IsVisible="{Binding HasAttachments}" Width="16" Height="16" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                            <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2" Text="{Binding Preview}" IsVisible="{Binding HasPreview}" Classes="caption" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="3" Text="{Binding State}" IsVisible="{Binding HasState}" Classes="caption" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Name="StatusNotification"
                            IsVisible="{Binding HasStatus}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            MaxWidth="400"
                            Margin="16"
                            Padding="16,12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MailLineBrush}"
                            Background="{DynamicResource MailButtonBrush}">
                        <ScrollViewer Name="StatusScroll"
                                      Focusable="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      AutomationProperties.Name="{x:Static ui:Strings.StatusNotifications}">
                            <StackPanel Spacing="6">
                                <Grid Name="ActivityStatus" ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding HasActiveWork}">
                                    <Path Name="SyncSpinner"
                                          Classes="sync-spinner"
                                          Width="20"
                                          Height="20"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource MailAccentBrush}"
                                          StrokeThickness="2"
                                          Data="M 9,1 A 8,8 0 1 1 2,5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Name="SynchronisationStatus" Text="{x:Static ui:Strings.Synchronising}" IsVisible="{Binding IsSynchronising}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock Name="BatchActionStatus" Text="{x:Static ui:Strings.BatchActionRunning}" IsVisible="{Binding IsBatchActionRunning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Name="FeedbackStatus" Text="{Binding FeedbackStatus}" IsVisible="{Binding HasFeedbackStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Name="NotificationFailureStatus" Text="{Binding NotificationStatus}" IsVisible="{Binding HasNotificationStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </DockPanel>
            <GridSplitter Name="PreviewSplitter" Grid.Column="3" ResizeDirection="Columns" AutomationProperties.Name="{x:Static ui:Strings.PreviewResize}" />
            <DockPanel Grid.Column="4" Name="PreviewPane">
                <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MailLineBrush}">
                    <Grid Name="ReaderToolbar" ColumnDefinitions="*,Auto" MinHeight="64" Margin="16,0">
                        <StackPanel Name="ReaderActions" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="EditDraftButton" Classes="quiet" Padding="8" AutomationProperties.Name="{x:Static ui:Strings.EditDraft}" IsVisible="False" IsEnabled="{Binding HasSelection}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{x:Static ui:MailIcons.Rename}" Width="18" Height="18" />
                                    <TextBlock Text="{x:Static ui:Strings.EditDraft}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Name="ReplyButton" Classes="quiet" Padding="8" AutomationProperties.Name="{x:Static ui:Strings.Reply}" IsEnabled="{Binding CanComposeFromMessage}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{StaticResource ReplyIcon}" Width="18" Height="18" />
                                    <TextBlock Text="{x:Static ui:Strings.Reply}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Name="ReplyAllButton" Classes="quiet" Padding="8" AutomationProperties.Name="{x:Static ui:Strings.ReplyAll}" IsEnabled="{Binding CanReplyAll}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{StaticResource ReplyAllIcon}" Width="18" Height="18" />
                                    <TextBlock Text="{x:Static ui:Strings.ReplyAll}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Name="ForwardButton" Classes="quiet" Padding="8" AutomationProperties.Name="{x:Static ui:Strings.Forward}" IsEnabled="{Binding CanComposeFromMessage}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{StaticResource ForwardIcon}" Width="18" Height="18" />
                                    <TextBlock Text="{x:Static ui:Strings.Forward}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Name="ReaderActionDivider" Background="{DynamicResource MailLineBrush}" Width="1" Height="24" Margin="8,0" VerticalAlignment="Center" />
                            <Button Name="ReadButton" Classes="quiet" Padding="8" AutomationProperties.Name="{Binding ReadAction}" Command="{Binding ReadCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{StaticResource ReadIcon}" Width="18" Height="18" />
                                    <TextBlock Text="{Binding ReadAction}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Name="TrashButton" Classes="quiet" Padding="8" AutomationProperties.Name="{Binding TrashAction}" Command="{Binding TrashCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="{StaticResource TrashIcon}" Width="18" Height="18" />
                                    <TextBlock Text="{Binding TrashAction}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Name="ReaderMoreButton" Grid.Column="1" Classes="quiet" Padding="10" MinWidth="40" MinHeight="40" VerticalAlignment="Center" AutomationProperties.Name="{x:Static ui:Strings.MessageActions}" ToolTip.Tip="{x:Static ui:Strings.MessageActions}" Click="OpenMenuClicked">
                            <Path Data="{StaticResource MoreIcon}" Fill="{DynamicResource MailTextBrush}" StrokeThickness="0" Width="20" Height="5" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Name="OverflowReplyAllButton" Header="{x:Static ui:Strings.ReplyAll}" IsEnabled="{Binding CanReplyAll}" />
                                    <MenuItem Name="OverflowForwardButton" Header="{x:Static ui:Strings.Forward}" IsEnabled="{Binding CanComposeFromMessage}" />
                                    <MenuItem Name="OverflowReadButton" Header="{Binding ReadAction}" Command="{Binding ReadCommand}" />
                                    <MenuItem Name="OverflowTrashButton" Header="{Binding TrashAction}" Command="{Binding TrashCommand}" />
                                    <Separator />
                                    <MenuItem Header="{x:Static ui:Strings.Retrieve}" Command="{Binding RetrieveCommand}" />
                                    <MenuItem Header="{x:Static ui:Strings.Archive}" Command="{Binding ArchiveCommand}" />
                                    <MenuItem Name="MoveButton" Header="{x:Static ui:Strings.Move}" IsEnabled="{Binding CanMove}" ToolTip.Tip="{Binding MoveSupport}" />
                                    <MenuItem Name="ImagesButton" Header="{x:Static ui:Strings.LoadImages}" IsEnabled="False" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </Border>
                <Grid>
                    <ScrollViewer Name="PlainPreviewScroll" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="ReaderContent" Margin="24" Spacing="0">
                            <StackPanel Name="ReaderHeader" Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding ReaderSubject}" FontWeight="Bold" FontSize="{DynamicResource SubjectFontSize}" TextWrapping="Wrap" />
                                    <ToggleButton Grid.Column="1" Classes="flag" Command="{Binding FlagCommand}" IsChecked="{Binding Selected.Flagged, Mode=OneWay}" AutomationProperties.Name="{x:Static ui:Strings.Flag}" Background="Transparent" BorderThickness="0" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <Path Data="{StaticResource StarIcon}" Width="22" Height="22" />
                                    </ToggleButton>
                                </Grid>
                                <Grid ColumnDefinitions="48,*,Auto" RowDefinitions="Auto,Auto" IsVisible="{Binding HasSelection}">
                                    <Border Grid.RowSpan="2" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource MailAvatarSelectedBrush}">
                                        <TextBlock Text="{Binding ReaderInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding ReaderSender}" FontWeight="SemiBold" Margin="16,0,8,0" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding ReaderAddress}" Classes="caption" Margin="16,4,8,0" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding ReaderTime}" Classes="caption" ToolTip.Tip="{Binding ReaderDate}" />
                                </Grid>
                                <DockPanel IsVisible="{Binding HasSelection}">
                                    <Button DockPanel.Dock="Right" Name="DetailsButton" Classes="quiet" Content="⌄" AutomationProperties.Name="{x:Static ui:Strings.MessageDetails}" />
                                    <TextBlock Text="{Binding ReaderTo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                            <SelectableTextBlock Name="PlainPreview" Text="{Binding Body}" Focusable="True" TextWrapping="Wrap" FontSize="{DynamicResource BodyFontSize}" LineHeight="{DynamicResource BodyLineHeight}" Margin="0,24,0,0" AutomationProperties.Name="{x:Static ui:Strings.Preview}" />
                            <TextBlock Name="HtmlReadingStatus" IsVisible="False" TextWrapping="Wrap" FontSize="{DynamicResource BodyFontSize}" Margin="0,24,0,0" />
                            <StackPanel Name="ReaderAttachmentPanel" IsVisible="{Binding HasAttachments}" Margin="0,32,0,0" Spacing="12">
                                <Border Background="{DynamicResource MailLineBrush}" Height="1" />
                                <TextBlock Text="{Binding AttachmentHeading}" />
                                <ListBox Name="AttachmentList" Classes="mail" ItemsSource="{Binding Attachments}" AutomationProperties.Name="{x:Static ui:Strings.Attach}">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem" x:DataType="core:AttachmentSnapshot">
                                            <Setter Property="Margin" Value="0,0,12,12" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="ContextMenu">
                                                <ContextMenu>
                                                    <MenuItem Header="{x:Static ui:Strings.Destination}" Click="SaveAttachmentClicked" />
                                                </ContextMenu>
                                            </Setter>
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding MediaType}" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:AttachmentSnapshot">
                                            <Border Classes="card" Width="248" MinHeight="72" ToolTip.Tip="{Binding MediaType}">
                                                <Grid ColumnDefinitions="36,*">
                                                    <Path Data="{x:Static ui:MailIcons.Draft}" Width="24" Height="24" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding MediaType, Converter={StaticResource AttachmentType}}" Classes="caption" />
                                                            <TextBlock Text="{Binding Length, Converter={StaticResource AttachmentSize}}" Classes="caption" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Availability, Converter={StaticResource ContentState}}" IsVisible="{Binding Availability, Converter={StaticResource ContentState}, ConverterParameter=IsUnavailable}" Classes="caption" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Name="HtmlReaderGrid" IsVisible="False" RowDefinitions="Auto,*,Auto" Margin="24,12">
                        <ScrollViewer Name="HtmlHeaderScroll" MaxHeight="220" HorizontalScrollBarVisibility="Disabled" />
                        <ContentControl Name="HtmlSurface" Grid.Row="1" IsVisible="False" Margin="0,16" />
                        <ScrollViewer Name="HtmlAttachmentScroll" Grid.Row="2" MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Name="HtmlFooter" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
