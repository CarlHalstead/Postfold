<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>10.0</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <Deterministic>true</Deterministic>
    </PropertyGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Postfold.UI' Or '$(MSBuildProjectName)' == 'Postfold.Desktop' Or '$(MSBuildProjectName)' == 'Postfold.Foundation.Tests' Or '$(MSBuildProjectName)' == 'Postfold.Engine.Tests'">
        <!-- The inherited build telemetry package contributes no client functionality. -->
        <PackageReference Include="Avalonia.BuildServices" ExcludeAssets="all" PrivateAssets="all" />
    </ItemGroup>
</Project>
