<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <StartupObject>Postfold.Foundation.Tests.Fixtures.Desktop.QualificationProgram</StartupObject>
        <ApplicationManifest>../Postfold.Desktop/app.manifest</ApplicationManifest>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../Postfold.Engine.Tests/Fixtures/LocalMailServer.cs" Link="Fixtures/LocalMailServer.cs" />
        <Compile Include="../Postfold.Engine.Tests/Fixtures/EngineFixture.cs" Link="Fixtures/EngineFixture.cs" />
        <ProjectReference Include="../Postfold.Desktop/Postfold.Desktop.csproj" />
        <ProjectReference Include="../Postfold.UpdateSigner/Postfold.UpdateSigner.csproj" />
        <PackageReference Include="Avalonia.Headless.NUnit" />
        <PackageReference Include="Microsoft.Web.WebView2" ExcludeAssets="compile;build;buildTransitive"
                          PrivateAssets="all" GeneratePathProperty="true" />
        <Reference Include="Microsoft.Web.WebView2.Core">
            <HintPath>$(PkgMicrosoft_Web_WebView2)/lib_manual/netcoreapp3.0/Microsoft.Web.WebView2.Core.dll</HintPath>
        </Reference>
        <PackageReference Include="NUnit" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NUnit3TestAdapter" PrivateAssets="all" />
        <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    </ItemGroup>
</Project>
